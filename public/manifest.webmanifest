{
  "id": "/chat",
  "name": "ChatUp — Meet someone new",
  "short_name": "ChatUp",
  "description": "A hello can go anywhere. Text, voice, video, and little games with new connections.",
  "start_url": "/chat?source=installed",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f8f7fc",
  "theme_color": "#7863e6",
  "lang": "en",
  "categories": ["social", "communication"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Meet someone", "url": "/chat" },
    { "name": "Friends", "url": "/chat?view=friends" },
    { "name": "Explore rooms", "url": "/chat?view=rooms" }
  ]
}
