{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatup-web",
  "account_id": "6418d8b7a0996630c6eb574d93c85b54",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "vars": {
    "API_BASE_URL": "https://elsewhere-api.robloxproxy.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "chatup.chat",
      "custom_domain": true,
      "zone_id": "c165b6f8cc85ffb45520f8adad02479e"
    }
  ]
}
