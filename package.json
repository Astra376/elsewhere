{
  "name": "elsewhere",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "dev:api": "wrangler dev --config wrangler.api.jsonc --port 8787",
    "build:api": "wrangler deploy --config wrangler.api.jsonc --dry-run --outdir api-dist",
    "db:local": "wrangler d1 migrations apply elsewhere-db --local --config wrangler.api.jsonc",
    "typecheck": "tsc --noEmit",
    "types:api": "wrangler types server/worker-configuration.d.ts --config wrangler.api.production.jsonc --env-interface WorkerBindings --include-runtime false --strict-vars false",
    "test": "vitest run",
    "test:providers": "vitest run --config vitest.workers.config.ts",
    "test:integration": "node scripts/integration.mjs",
    "test:browser": "playwright test",
    "deploy:api": "wrangler deploy --config wrangler.api.production.jsonc --keep-vars",
    "deploy:web": "wrangler deploy --config wrangler.web.production.jsonc --keep-vars",
    "db:remote": "wrangler d1 migrations apply elsewhere-db --remote --config wrangler.api.production.jsonc",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:providers && npm run build:api && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@cloudflare/realtimekit": "^2.0.2",
    "@shadcn/react": "0.3.0",
    "better-auth": "^1.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "stripe": "^22.6.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "0.31.10",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "type": "module",
  "overrides": {
    "uuid": "11.1.1",
    "sharp": "0.35.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
